---
/**
 * Sección 06 — "El equipo". Cierra la home con las personas detrás del
 * proyecto (Equipo 112) y el Instagram oficial del juego.
 */
import { Image } from "astro:assets";
import cristian from "../../public/integrantes/cristian-rios.jpg";
import franco from "../../public/integrantes/franco-vallejos.jpg";
import giuliano from "../../public/integrantes/giuliano-di-tomasso.jpg";
import maximo from "../../public/integrantes/maximo-bosch.jpg";

// Orden alfabético por apellido: Bosch, Di Tommaso, Rios, Vallejos.
const integrantes = [
  {
    nombre: "Máximo Bosch",
    foto: maximo,
    linkedin: "https://www.linkedin.com/in/maximo-augusto-bosch/",
  },
  {
    nombre: "Giuliano Di Tommaso",
    foto: giuliano,
    linkedin: "https://www.linkedin.com/in/giuliano-di-tommaso",
  },
  {
    nombre: "Cristian Rios",
    foto: cristian,
    linkedin: "https://ar.linkedin.com/in/cristian-rios-0719b8134",
  },
  {
    nombre: "Franco Vallejos",
    foto: franco,
    linkedin: "https://www.linkedin.com/in/franco-nicolas-vallejos-a43b18187/",
  },
];
---

<section class="section team" id="equipo">
  <div class="wrap">
    <p class="eyebrow" data-reveal>06 — El equipo</p>

    <h2 class="title" data-reveal>El equipo detrás<br />del proyecto</h2>

    <p class="lead" data-reveal style="--reveal-delay:90ms">
      Mortuorium es un proyecto del Equipo 112 de la materia Proyecto Final de
      la carrera de Ingenieria en Informatica de la UNLaM. Seguí el desarrollo
      en
      <a
        class="ig-link"
        href="https://www.instagram.com/mortuorium_unlam/"
        target="_blank"
        rel="noopener noreferrer"
        ><svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          aria-hidden="true"
          ><rect x="3" y="3" width="18" height="18" rx="5"></rect><circle
            cx="12"
            cy="12"
            r="4"></circle><circle
            cx="17.2"
            cy="6.8"
            r="1"
            fill="currentColor"
            stroke="none"></circle></svg
        >mortuorium_unlam</a
      >
      y a la universidad en
      <a
        class="ig-link"
        href="https://www.instagram.com/unlamoficial/"
        target="_blank"
        rel="noopener noreferrer"
        ><svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          aria-hidden="true"
          ><rect x="3" y="3" width="18" height="18" rx="5"></rect><circle
            cx="12"
            cy="12"
            r="4"></circle><circle
            cx="17.2"
            cy="6.8"
            r="1"
            fill="currentColor"
            stroke="none"></circle></svg
        >unlamoficial</a
      >.
    </p>

    <ul class="members">
      {
        integrantes.map((m, i) => (
          <li class="member" data-reveal style={`--reveal-delay:${i * 90}ms`}>
            <a
              class="member__link"
              href={m.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`${m.nombre} en LinkedIn`}
            >
              <Image
                class="member__photo"
                src={m.foto}
                alt={m.nombre}
                width={200}
                height={200}
              />
              <span class="member__name">{m.nombre}</span>
              <span class="member__role">
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M4.98 3.5a2.5 2.5 0 11-.02 5 2.5 2.5 0 01.02-5zM3 9h4v12H3zM9 9h3.8v1.7h.05c.53-1 1.83-2.05 3.77-2.05 4.03 0 4.78 2.65 4.78 6.1V21h-4v-5.6c0-1.34-.02-3.07-1.87-3.07-1.87 0-2.16 1.46-2.16 2.97V21H9z" />
                </svg>
                LinkedIn
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .ig-link {
    display: inline-block;
    white-space: nowrap;
  }

  .ig-link svg {
    display: inline-block;
    width: 0.95em;
    height: 0.95em;
    margin-right: 0.2em;
    vertical-align: -0.15em;
  }

  .members {
    list-style: none;
    margin: clamp(2.5rem, 6vh, 4rem) 0 0;
    padding: 0;
    display: grid;
    gap: 1px;
    grid-template-columns: repeat(auto-fit, minmax(min(13rem, 100%), 1fr));
    background: var(--rule-soft);
    border: 1px solid var(--rule-soft);
  }

  .member {
    background-color: var(--card-fill);
    background-image: var(--card-bg);
    transition: background-image 0.45s var(--ease-out);
  }

  .member:hover {
    background-image: var(--card-bg-hover);
  }

  .member__link {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.9rem;
    padding: 2.2rem 1.6rem;
    color: var(--text);
  }

  .member__link:hover {
    color: var(--text);
  }

  .member__photo {
    width: 6.5rem;
    height: 6.5rem;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid var(--rule);
    filter: saturate(0.85);
    transition:
      border-color 0.35s var(--ease-out),
      filter 0.35s var(--ease-out);
  }

  .member__link:hover .member__photo {
    border-color: var(--accent-deep);
    filter: saturate(1);
  }

  .member__name {
    font-family: var(--font-display);
    font-size: 1.2rem;
    letter-spacing: 0.04em;
    text-align: center;
  }

  .member__role {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--text-faint);
    transition: color 0.25s var(--ease-out);
  }

  .member__link:hover .member__role {
    color: var(--accent);
  }

  .member__role svg {
    width: 0.85rem;
    height: 0.85rem;
  }
</style>
