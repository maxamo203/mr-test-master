---
/**
 * Sección 02 — "El ritual": la introducción marketinera. Promesa grande, tres
 * pilares y las cifras del juego. Sin detalle técnico: eso vive en /como-funciona.
 */

const pilares = [
  {
    titulo: "Solo tu teléfono",
    texto:
      "Entrá a la experiencia sin hardware dedicado. Si tenés el celular en la mano, ya estás adentro.",
    icono: "phone",
  },
  {
    titulo: "Más inmersión",
    texto:
      "Probalo con Cardboard, auriculares y joystick. La casa deja de ser tuya.",
    icono: "vr",
  },
  {
    titulo: "Cooperativo",
    texto: "Jugá con amigos en la misma sala. El ritual no se completa solo.",
    icono: "coop",
  },
];

const cifras = [
  { n: "6", label: "Noches" },
  { n: "3", label: "Entidades" },
  { n: "1", label: "Ritual" },
];
---

<section class="section" id="ritual">
  <div class="wrap">
    <p class="eyebrow" data-reveal>02 — El ritual</p>

    <h2 class="title" data-reveal>Tu casa es<br />el escenario</h2>

    <p class="lead" data-reveal style="--reveal-delay:90ms">
      No hay un mapa que memorizar. Mortuorium escanea tu habitación una vez y
      monta el ritual ahí adentro: tus paredes, tus muebles, tu oscuridad.
      Después apagás la luz.
    </p>

    <ul class="pillars">
      {
        pilares.map((p, i) => (
          <li class="pillar" data-reveal style={`--reveal-delay:${i * 110}ms`}>
            <span class="pillar__icon" aria-hidden="true">
              {p.icono === "phone" && (
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.2"
                >
                  <rect x="6" y="2" width="12" height="20" rx="2.5" />
                  <path d="M10.5 18.5h3" />
                  <path d="M9.5 7.5h5M9.5 10.5h5M9.5 13.5h3" opacity="0.55" />
                </svg>
              )}
              {p.icono === "vr" && (
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.2"
                >
                  <rect x="2" y="7" width="20" height="10" rx="3" />
                  <circle cx="7.5" cy="12" r="2.2" />
                  <circle cx="16.5" cy="12" r="2.2" />
                  <path d="M11 13.5c.6-.7 1.4-.7 2 0" />
                </svg>
              )}
              {p.icono === "coop" && (
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.2"
                >
                  <circle cx="9" cy="8" r="3" />
                  <circle cx="17" cy="9.5" r="2.2" />
                  <path d="M3.5 19c0-3 2.5-5 5.5-5s5.5 2 5.5 5" />
                  <path d="M16 14.2c2.4.2 4.5 2 4.5 4.8" opacity="0.6" />
                </svg>
              )}
            </span>
            <h3 class="pillar__title">{p.titulo}</h3>
            <p class="pillar__text">{p.texto}</p>
          </li>
        ))
      }
    </ul>

    <!-- <div class="figures" data-reveal>
      {
        cifras.map((c) => (
          <div class="figure">
            <span class="figure__n">{c.n}</span>
            <span class="figure__label">{c.label}</span>
          </div>
        ))
      }
    </div> -->

    <p class="creed" data-reveal>Solo tu fe puede salvarte</p>
  </div>
</section>

<style>
  .pillars {
    list-style: none;
    margin: clamp(3rem, 7vh, 5rem) 0 0;
    padding: 0;
    display: grid;
    gap: 1px; /* la grilla misma dibuja las divisiones */
    /* min(15rem, 100%): ver la nota en Stores.astro — un mínimo fijo mayor que
       la columna disponible hace desbordar la grilla en pantallas angostas. */
    grid-template-columns: repeat(auto-fit, minmax(min(15rem, 100%), 1fr));
    background: var(--rule-soft);
    border: 1px solid var(--rule-soft);
  }

  .pillar {
    padding: 2.2rem 1.9rem;
    /* Translúcido, no --bg: detrás corre el video de fondo (BackdropVideo) y
       un relleno opaco lo taparía entero en toda esta sección. */
    background-color: var(--card-fill);
    background-image: var(--card-bg);
    transition: background-image 0.45s var(--ease-out);
  }

  .pillar:hover {
    background-image: var(--card-bg-hover);
  }

  .pillar__icon {
    display: block;
    width: 2rem;
    height: 2rem;
    color: var(--accent);
    margin-bottom: 1.3rem;
  }

  .pillar__icon svg {
    width: 100%;
    height: 100%;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .pillar__title {
    font-size: 1.4rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 0.6rem;
  }

  .pillar__text {
    color: var(--text-muted);
    font-size: 0.92em;
  }

  /* --- cifras --------------------------------------------------------- */
  .figures {
    margin-top: clamp(3rem, 7vh, 5rem);
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border: 1px solid var(--rule-soft);
    background-image: var(--card-bg);
  }

  .figure {
    padding: 2rem 1rem;
    text-align: center;
  }

  .figure + .figure {
    border-left: 1px solid var(--rule-soft);
  }

  .figure__n {
    display: block;
    font-family: var(--font-display);
    font-size: clamp(2.6rem, 7vw, 4rem);
    line-height: 1;
    color: var(--accent);
  }

  .figure__label {
    display: block;
    margin-top: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  /* --- credo ---------------------------------------------------------- */
  .creed {
    margin-top: clamp(3.5rem, 8vh, 6rem);
    text-align: center;
    font-size: clamp(1.15rem, 3.2vw, 1.75rem);
    color: var(--text-soft);
    text-shadow: 0 0 2.2rem var(--glow-red);
  }
</style>
