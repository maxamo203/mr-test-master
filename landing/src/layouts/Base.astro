---
/**
 * Layout base de todas las páginas.
 *
 * Trae: <head> con fuentes y metadatos sociales, el riel lateral (Rail) y los
 * dos comportamientos globales — scroll-spy del riel y aparición de bloques al
 * entrar en pantalla. Ningún color se define acá: todo sale de globals.css.
 */
import '../styles/globals.css';
import Rail from '../components/Rail.astro';
import type { RailItem } from '../nav';

interface Props {
  title: string;
  description: string;
  items: RailItem[];
  back?: { href: string; label: string };
}

const { title, description, items, back } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/og.png" />
    <meta property="og:locale" content="es_AR" />
    <meta name="twitter:card" content="summary_large_image" />
    {/* Único color literal del sitio junto con el favicon: es un atributo HTML
        y no puede leer variables CSS. Es copia de --c-bg (globals.css). */}
    <meta name="theme-color" content="#060504" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=IBM+Plex+Mono:wght@400;500&family=Special+Elite&display=swap"
    />

    {/* Marca que hay JS ANTES del primer pintado: sólo entonces globals.css
        esconde los bloques con [data-reveal] para animarlos. Sin esto, un
        visitante sin JS (o un error temprano) vería la página en blanco. */}
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>

  <body>
    <a class="skip" href="#contenido">Saltar al contenido</a>
    <Rail items={items} back={back} />
    <div class="shell">
      <main id="contenido">
        <slot />
      </main>
    </div>

    <style>
      .skip {
        position: absolute;
        left: -9999px;
        top: 0;
        z-index: 100;
        padding: 0.75rem 1.25rem;
        background: var(--surface);
        color: var(--accent);
        font-family: var(--font-mono);
        font-size: 0.8rem;
        border: 1px solid var(--rule);
      }

      .skip:focus {
        left: 0.5rem;
        top: 0.5rem;
      }
    </style>

    <script>
      // --- 1) Aparición de bloques al entrar en pantalla -------------------
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const revealables = document.querySelectorAll<HTMLElement>('[data-reveal]');

      if (reduce) {
        revealables.forEach((el) => el.classList.add('is-in'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (!e.isIntersecting) continue;
              e.target.classList.add('is-in');
              io.unobserve(e.target); // una sola vez: no reanimar al volver
            }
          },
          { rootMargin: '0px 0px -12% 0px', threshold: 0.15 }
        );
        revealables.forEach((el) => io.observe(el));
      }

      // --- 2) Scroll-spy del riel -----------------------------------------
      const links = Array.from(
        document.querySelectorAll<HTMLAnchorElement>('[data-rail-link]')
      );
      const targets = links
        .map((l) => {
          const id = l.getAttribute('href')?.split('#')[1];
          const el = id ? document.getElementById(id) : null;
          return el ? { link: l, el } : null;
        })
        .filter((x): x is { link: HTMLAnchorElement; el: HTMLElement } => x !== null);

      if (targets.length > 0) {
        const setActive = (link: HTMLAnchorElement | null) => {
          for (const { link: l } of targets) {
            const on = l === link;
            l.classList.toggle('is-active', on);
            if (on) l.setAttribute('aria-current', 'true');
            else l.removeAttribute('aria-current');
          }
        };

        // La sección "activa" es la que cruza la banda media de la pantalla.
        const spy = new IntersectionObserver(
          () => {
            const mid = window.innerHeight * 0.42;
            let best: { link: HTMLAnchorElement; d: number } | null = null;
            for (const { link, el } of targets) {
              const r = el.getBoundingClientRect();
              if (r.bottom < 0 || r.top > window.innerHeight) continue;
              const d = Math.abs(r.top - mid);
              if (!best || d < best.d) best = { link, d };
            }
            setActive(best ? best.link : null);
          },
          { threshold: [0, 0.15, 0.35, 0.6, 0.9] }
        );
        targets.forEach(({ el }) => spy.observe(el));

        // Barra de progreso vertical del riel.
        const bar = document.querySelector<HTMLElement>('[data-rail-progress]');
        let ticking = false;
        const onScroll = () => {
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(() => {
            ticking = false;
            const max = document.documentElement.scrollHeight - window.innerHeight;
            const p = max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 0;
            bar?.style.setProperty('--progress', String(p));
          });
        };
        addEventListener('scroll', onScroll, { passive: true });
        addEventListener('resize', onScroll);
        onScroll();
      }
    </script>
  </body>
</html>
